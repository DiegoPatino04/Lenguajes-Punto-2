digraph automaton {
  rankdir=LR;
  node [shape=circle, fontname="Times-Roman"];
  edge [fontname="Times-Roman"];
  __start [shape=point, label=""];
  "q3" [shape=doublecircle];
  "q7" [shape=doublecircle];
  __start -> "q0";
  "q0" -> "q1" [label="ε", style=dashed, color="#1f4fbf", fontcolor="#1f4fbf"];
  "q0" -> "q4" [label="ε", style=dashed, color="#1f4fbf", fontcolor="#1f4fbf"];
  "q1" -> "q2" [label="0"];
  "q2" -> "q3" [label="1"];
  "q3" -> "q1" [label="ε", style=dashed, color="#1f4fbf", fontcolor="#1f4fbf"];
  "q4" -> "q5" [label="0"];
  "q5" -> "q6" [label="1"];
  "q6" -> "q7" [label="0"];
  "q7" -> "q4" [label="ε", style=dashed, color="#1f4fbf", fontcolor="#1f4fbf"];
}
